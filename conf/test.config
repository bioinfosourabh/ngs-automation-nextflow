/*
 * Minimal test: synthetic two-contig reference and four simulated samples
 * (two normals, one tumour-normal pair, one tumour-only sample). Intended for
 * `-stub-run` checks in CI and for a quick end-to-end run with containers:
 *
 *   nextflow run . -profile test,docker --outdir results
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic data set for checking that the pipeline runs'

    input                  = "${projectDir}/assets/samplesheet_test.csv"
    outdir                 = 'results_test'
    fasta                  = "${projectDir}/tests/data/genome.fasta"
    intervals              = "${projectDir}/tests/data/targets.bed"
    dbsnp                  = "${projectDir}/tests/data/dbsnp.vcf.gz"
    known_indels           = "${projectDir}/tests/data/known_indels.vcf.gz"
    germline_resource      = "${projectDir}/tests/data/germline_resource.vcf.gz"
    pon                    = "${projectDir}/tests/data/pon.vcf.gz"
    contamination_variants = "${projectDir}/tests/data/common_variants.vcf.gz"
    scatter_count          = 2
    germline_filter        = 'hard'
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
