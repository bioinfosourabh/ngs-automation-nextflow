/*
 * Per-process arguments and output names.
 *   ext.args   additional command-line arguments
 *   ext.prefix output file prefix
 */

process {
    withName: 'FASTP' {
        // Phred 20 qualified-base threshold, drop reads shorter than 36 bp after trimming.
        ext.args = '--qualified_quality_phred 20 --length_required 36'
    }
    withName: 'ENSEMBLVEP_VEP' {
        ext.args = '--symbol --canonical --biotype --numbers --hgvs --variant_class --mane --af_gnomade --af_gnomadg --pick_allele_gene'
    }
}
