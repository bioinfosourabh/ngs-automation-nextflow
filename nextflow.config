/*
 * ngs-automation-nextflow: default configuration
 */

manifest {
    name            = 'bioinfosourabh/ngs-automation-nextflow'
    contributors    = [
        [
            name        : 'Sourabh Kumar',
            email       : 'bioinfosourabh@gmail.com',
            github      : 'bioinfosourabh',
            orcid       : 'https://orcid.org/0009-0009-5840-9830',
            contribution: ['author', 'maintainer']
        ]
    ]
    homePage        = 'https://github.com/bioinfosourabh/ngs-automation-nextflow'
    description     = 'Germline and somatic short-variant calling from paired-end FASTQ with GATK4'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
    license         = 'MIT'
}

params {
    // Input / output
    input                     = null
    outdir                    = null
    publish_dir_mode          = 'copy'
    seq_platform              = 'ILLUMINA'

    // Reference genome and indexes (missing indexes are built)
    fasta                     = null
    fasta_fai                 = null
    dict                      = null
    bwa_index                 = null
    aligner                   = 'bwa-mem2'

    // Target regions (BED). Leave unset for whole-genome data.
    intervals                 = null
    interval_padding          = 0
    scatter_count             = 8

    // Known sites for BQSR (and dbSNP annotation of germline calls)
    dbsnp                     = null
    known_indels              = null

    // Germline
    run_germline              = true
    joint_caller              = 'genomicsdb'
    germline_filter           = 'hard'
    vqsr_hapmap               = null
    vqsr_omni                 = null
    vqsr_1000g                = null
    vqsr_mills                = null
    vqsr_axiom                = null
    vqsr_snp_filter_level     = 99.7
    vqsr_indel_filter_level   = 99.0
    save_gvcf                 = false

    // Somatic
    run_somatic               = true
    germline_resource         = null
    pon                       = null
    contamination_variants    = null

    // Annotation
    run_vep                   = false
    vep_cache                 = null
    vep_species               = 'homo_sapiens'
    vep_genome                = 'GRCh38'
    vep_cache_version         = 114

    // Intermediate files
    save_reference            = false
    save_trimmed              = false
    save_aligned              = false
    save_markdup              = false
    skip_multiqc              = false

    // AWS Batch
    awsqueue                  = null
    awsregion                 = 'eu-west-2'
    awscli                    = null
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        apptainer.enabled      = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = params.awsqueue
        aws.region             = params.awsregion
        aws.batch.cliPath      = params.awscli
        docker.enabled         = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Avoid picking up host-specific Python, R or Julia settings inside containers
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
    JULIA_DEPOT_PATH = '/usr/local/share/julia'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
